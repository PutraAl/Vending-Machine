# Broker (TLS + autentikasi, sesuai MQTT/config/mosquitto-test.conf)
MQTT_BROKER=localhost
MQTT_PORT=8883
MQTT_CLIENT_ID=vending-simulator-machine-1
MQTT_KEEPALIVE=60
MQTT_CONNECT_TIMEOUT=15
MQTT_QOS=1

# Akun simulator (user ini harus ada di password file dan ACL broker)
MQTT_USERNAME=
MQTT_PASSWORD=

# Sertifikat CA yang dipercaya (path relatif terhadap folder simulator, atau absolut)
MQTT_CA_CERT=certs/ca-trust.crt

# Identitas mesin (harus sama dengan machines.id di database Laravel)
MQTT_MACHINE_ID=1

# Simulasi
SIMULATOR_TEMPERATURE_C=72.5
TEMPERATURE_TELEMETRY_INTERVAL=5
