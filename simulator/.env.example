# Broker TLS + authentication, aligned with the secured Mosquitto profile.
MQTT_BROKER=localhost
MQTT_PORT=8883
MQTT_CLIENT_ID=vending-simulator-machine-1
MQTT_KEEPALIVE=60
MQTT_CONNECT_TIMEOUT=15
MQTT_QOS=1

# Akun simulator (user ini harus ada di password file dan ACL broker)
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=true
MQTT_REQUIRE_MACHINE_ID=true
MQTT_REQUIRE_COMMAND_EXPIRY=true

# Optional CA bundle path. Leave blank for a broker certificate from a public CA.
# Set this to certs/ca-trust.crt only for the local self-signed test broker.
MQTT_CA_CERT=

# Identitas mesin (harus sama dengan machines.id di database Laravel)
MQTT_MACHINE_ID=1

# Simulasi
SIMULATOR_TEMPERATURE_C=72.5
TEMPERATURE_TELEMETRY_INTERVAL=5
