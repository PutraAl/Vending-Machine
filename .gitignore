# ==================================================
# CERTIFICATES
# Keep public CA certificates (for example, EMQX CA).
# Never commit private keys or private certificate bundles.
# ==================================================
/certs/*.key
/certs/*-key.pem
/certs/*-private.pem
/certs/*_private.pem
/certs/private*.pem
/certs/private/
/certs/*.p12
/certs/*.pfx

/MQTT/private-ca/
/MQTT/certs/*.key
/MQTT/certs/*-key.pem
/MQTT/certs/*-private.pem
/MQTT/certs/*_private.pem
/MQTT/certs/private*.pem
/certs/*-private.pem
/certs/*_private.pem
/certs/private*.pem
/MQTT/certs/private/
/MQTT/config/password.txt

/simulator/certs/*.key
/simulator/certs/*-key.pem
/simulator/certs/*-private.pem
/simulator/certs/*_private.pem
/simulator/certs/private*.pem
/certs/*-private.pem
/certs/*_private.pem
/certs/private*.pem
/simulator/certs/private/

# ==================================================
# LARAVEL / PHP BACKEND
# ==================================================
/backend/vendor/
/backend/node_modules/
/backend/public/build/
/backend/public/hot
/backend/public/storage

# Laravel generated bootstrap cache; retain placeholder files.
/backend/bootstrap/cache/*.php
!/backend/bootstrap/cache/.gitignore

# Laravel storage runtime files; retain directory placeholders.
/backend/storage/*.key
/backend/storage/pail
/backend/storage/app/private/*
!/backend/storage/app/private/.gitignore
/backend/storage/app/public/*
!/backend/storage/app/public/.gitignore

/backend/storage/framework/cache/*
!/backend/storage/framework/cache/.gitignore
!/backend/storage/framework/cache/data/
/backend/storage/framework/cache/data/*
!/backend/storage/framework/cache/data/.gitignore

/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore
/backend/storage/framework/testing/*
!/backend/storage/framework/testing/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore
/backend/storage/logs/*
!/backend/storage/logs/.gitignore

# Local SQLite databases and sidecar files; migrations remain tracked.
/backend/database/*.sqlite
/backend/database/*.sqlite3
/backend/database/*.sqlite-wal
/backend/database/*.sqlite-shm
/backend/database/*.sqlite3-wal
/backend/database/*.sqlite3-shm

/backend/.phpunit.cache/
/backend/.phpunit.result.cache
/backend/.phpactor.json
/backend/test-repair-backup/
/backend/dispense-api-test-current.txt
/backend/test-failures-only.txt
/backend/test-results-after-fix.txt
/backend/test-results.txt

